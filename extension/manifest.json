{
  "manifest_version": 3,
  "name": "MIghTy — LinkedIn Outreach",
  "version": "0.1.0",
  "description": "Shortlist LinkedIn profiles you're viewing and log confirmed sends back to your MIghTy account. Never clicks Connect/Message for you.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.supabase.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "MIghTy — LinkedIn Outreach" }
}
